# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Providers ---------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
# OpenRouter. OPENAI_API_KEY is accepted as a fallback so a .env copied from
# Nocturne (where the OpenRouter key lives under that name) keeps working.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Model overrides (optional — LiteLLM ids, "provider/model")
# GROQ_MODEL=groq/llama-3.3-70b-versatile
# GEMINI_MODEL=gemini/gemini-2.5-flash-lite
# OPENROUTER_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free

# Per-call ceiling, seconds
# REQUEST_TIMEOUT_S=30

# Canned completions instead of real provider calls — used by the demo and the
# benchmark so they never spend quota. Never turn this on in real use.
# GATEWAY_FAKE_PROVIDERS=0
# GATEWAY_FAKE_LATENCY_MS=120

# --- Health window -----------------------------------------------------------
# HEALTH_WINDOW_S=300

# --- Circuit breaker ---------------------------------------------------------
# BREAKER_MIN_SAMPLES=5          # don't judge a provider on one bad call
# BREAKER_ERROR_RATE=0.5         # >50% errors in the window → open
# BREAKER_P95_BUDGET_MS=15000    # slow counts as broken (free tiers really are slow)
# BREAKER_COOLDOWN_S=30          # open → half-open after this
# BREAKER_HALF_OPEN_PROBES=1     # probes allowed while half-open

# --- Hedging (interactive class only; ~2x spend on hedged calls) --------------
# HEDGE_MS=0                     # e.g. 800 to hedge after 800ms. 0 = off.

# --- Deferrable queue --------------------------------------------------------
# QUEUE_MAX_ATTEMPTS=5
# QUEUE_BACKOFF_BASE_S=2
# QUEUE_BACKOFF_MAX_S=300
# QUEUE_JITTER=0.3
# IDEMPOTENCY_TTL_S=86400
# WORKER_POLL_S=1.0

# --- Redis / Upstash ---------------------------------------------------------
# Empty = in-process fallback (fine for one instance and for the demo).
# Set it to make the health window, the queue and idempotency survive a restart.
REDIS_URL=

# --- Admin -------------------------------------------------------------------
# Empty = /admin/* is open (fine on localhost). Set it before exposing the port.
ADMIN_TOKEN=
